{
  "name": "neco_weekli",
  "private": true,
  "version": "0.0.0",
  "description": "Weekli — turn a weekly paycheck into one trustworthy Safe-to-Spend number.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "core:test": "pnpm --filter @neco/core test",
    "db:generate": "pnpm --filter @neco/core db:generate",
    "db:push": "pnpm --filter @neco/core db:push"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
