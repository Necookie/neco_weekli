# =============================================================================
# Weekli — environment variables
# Copy this file to `.env` (root, for scripts/drizzle) and to
# `apps/web/.env.local` (for the Next.js app). NEVER commit the filled-in files.
# =============================================================================

# --- Turso (libSQL) database -------------------------------------------------
# Create a DB:  turso db create weekli   then  turso db show weekli --url
#               turso db tokens create weekli
TURSO_DATABASE_URL=libsql://weekli-<your-org>.turso.io
TURSO_AUTH_TOKEN=

# Used by drizzle-kit + the Turso MCP server (account-level, not DB-level)
#   turso auth token          -> TURSO_API_TOKEN
#   turso org list            -> TURSO_ORGANIZATION (the slug)
TURSO_API_TOKEN=
TURSO_ORGANIZATION=

# --- Auth (Better Auth — default) --------------------------------------------
# openssl rand -base64 32   (or any 32+ char random string)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# OAuth providers (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Web Push (VAPID) for bill reminders -------------------------------------
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dheyn.main@gmail.com

# --- App config --------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=PHP
NEXT_PUBLIC_DEFAULT_LOCALE=en-PH

# --- MCP server tokens (consumed by .mcp.json) -------------------------------
# GitHub PAT with `repo` scope (or reuse your gh token).
GITHUB_PERSONAL_ACCESS_TOKEN=
